# Application
APP_NAME=Dobby
APP_VERSION=0.1.0
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# Database (matches docker-compose.yml)
# Port 5433 matches docker-compose (avoids local Postgres on 5432)
DATABASE_URL=postgresql+asyncpg://dobby:dobby@localhost:5433/dobby

# OpenAI (required for live LLM responses)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

ELEVENLABS_API_KEY=sk-elevenlabs-api-key

# Voice (uses OPENAI_API_KEY)
VOICE_STT_MODEL=whisper-1
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=alloy
# 0.25–4.0; default 1.2 is slightly faster than normal speech
VOICE_TTS_SPEED=1.2

# Agent
MAX_TOOL_ITERATIONS=5
CONVERSATION_MESSAGE_LIMIT=30
